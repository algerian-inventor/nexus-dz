# NEXUS DZ — Environment Configuration Example
# Copy this file to .env.local and provide your actual Supabase project credentials.
# Do NOT commit .env or .env.local to version control.

# Application Metadata
VITE_APP_NAME="NEXUS DZ"
VITE_APP_DEFAULT_LOCALE="ar"
VITE_APP_DEFAULT_WILAYA="25 - Constantine"

# Supabase Configuration (Required for live database, authentication & storage)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Supabase Storage Buckets
VITE_SUPABASE_EVIDENCE_BUCKET="initiative-evidence"
VITE_SUPABASE_ORG_DOCS_BUCKET="organization-documents"
VITE_SUPABASE_AVATARS_BUCKET="avatars"
